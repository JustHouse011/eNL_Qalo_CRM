# No environment variables are required for the standalone frontend demo.
# Production authentication and provider configuration will be specified by the backend engineer.
# Historical backend code is inactive; do not add credentials to this frontend.
# Optional, developer-server-only Live Visitors fixtures and in-memory activity simulation.
# Production builds ignore this switch. Disabled mode never falls back to fixtures.
VITE_CRM_DEMO_MODE=false
# Leave false until the same-origin staff-auth service and real staff sign-in are integrated.
# This flag is public configuration, never a secret. See docs/PASSWORD-RECOVERY.md.
VITE_STAFF_PASSWORD_RECOVERY_ENABLED=false
